[Unit]
# Пользовательский юнит, не системный: демон работает с правами владельца
# файлов (БТ §4.1).
Description=LocalRAG — локальный индексатор файлов пользователя
Documentation=file:/usr/lib/lib-local-rag/mcp/README.md
# Юниты включены глобально — для каждого systemd --user, в том числе greeter-а
# и root. Без условия root проиндексировал бы весь /home в /root/.files-search.
ConditionUser=!@system
# Токены агентов раскладывает регистрация. Демон перечитывает auth.json сам,
# After= лишь убирает окно 401 при первом входе, если регистрация (idle-IO)
# медленнее прогрева. Только порядок, без Requires=: сбой регистрации старт
# демона не блокирует, зависание — не дольше её TimeoutStartSec.
After=lib-local-rag-mcp-register.service
# Предел запусков: при устойчивом сбое каждый круг — прогрев OpenVINO 40-45 c
# на всех ядрах, а умолчание менеджера (5 за 10 c) при RestartSec=5 недостижимо,
# и юнит крутился бы вечно, не переходя в failed. Окно вмещает и 5 кругов
# сторожа при устойчивом зависании: прогрев + 300 c зависшего инференса
# (INFER_STALL_LIMIT_S) + WatchdogSec + TimeoutStopSec (ожидание после SIGABRT)
# + RestartSec ≈ 545 c на круг.
StartLimitIntervalSec=3600
StartLimitBurst=5

[Service]
# notify: служба active только после READY=1, а демон шлёт его по окончании
# прогрева модели (src/server/app.py) — без READY=1 старт упадёт по таймауту.
Type=notify
Environment=CONFIG_PATH=/etc/lib-local-rag/distro.yml
# Явно, хотя это и умолчание (src/bind_host.py): только loopback. Внешний адрес
# демон примет лишь вместе с LQRAG_EXPOSE=1, а запросы по нему — с
# RAG_ALLOWED_HOSTS; токен агента тогда идёт по сети открытым текстом.
Environment=RAG_HOST=127.0.0.1
# 0 — порт выбирает ядро, демон публикует фактический в ~/.files-search/port.
# MCP-мост читает его оттуда, поэтому конфиг агента не привязан к номеру.
Environment=RAG_PORT=0
# Иначе stdout в пайп systemd буферизуется блоками, и логи доходят до журнала
# пачками с задержкой.
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/lib-local-rag/main
# Явно, хотя это умолчание: образ может переопределить DefaultStandardOutput= в
# /etc/systemd/user.conf. SyslogIdentifier — иначе в журнале имя бинаря «main».
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lib-local-rag
Restart=on-failure
RestartSec=5
# Ограничивает старт до READY=1, то есть и прогрев OpenVINO (40-45 c, на
# медленной машине до полутора минут).
TimeoutStartSec=180
# Сторож: демон продлевает его из event loop (WATCHDOG=1 каждые 60 c), пока
# инференс не висит дольше INFER_STALL_LIMIT_S. Пинга нет — systemd шлёт
# SIGABRT (faulthandler пишет в журнал стеки всех потоков) и перезапускает.
WatchdogSec=120
# uvicorn завершается за 5 c по SIGTERM, затем демон снимает port/pid — с запасом.
TimeoutStopSec=30
# Nice= и IOSchedulingClass= не ставить: systemd применяет их до exec, а nice на
# старте вешает компиляцию модели OpenVINO. Демон сам понижает nice фоновых
# потоков обхода, разбора и перестройки индексов (src/utils/thread_priority.py);
# инференс эмбеддингов идёт в потоках OpenVINO с обычным приоритетом, его долю
# CPU ограничивает RAG_OV_NUM_THREADS.

[Install]
WantedBy=default.target
