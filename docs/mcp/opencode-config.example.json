{
  // Образец подключения MCP-моста LocalRAG к агенту на opencode-схеме:
  // Workspace Computer (~/.wsc/config/wsc.json) и GigaTool.
  //
  // Комментарии здесь допустимы: в config-schema.json агента стоят
  // allowComments и allowTrailingCommas, то есть конфиг читается как JSONC.
  // register_mcp.py тоже умеет их читать, но при записи не сохраняет —
  // после автоматической регистрации комментарии из файла исчезнут.
  //
  // Подставьте АБСОЛЮТНЫЙ путь к mcp_launcher.sh своей установки. Из пакета
  // это /usr/lib/lib-local-rag/mcp/mcp_launcher.sh; путь из рабочей копии
  // не переживёт её удаления.
  //
  // Обычно руками это писать не нужно — регистрацию делает
  //     python3 /usr/lib/lib-local-rag/mcp/register_mcp.py --all
  // и пользовательский юнит lib-local-rag-mcp-register.service.
  "mcp": {
    // Ключ — ИМЯ СЕРВЕРА. Не "servers": вложенности здесь нет, и запись вида
    // mcp.servers.localrag читается агентом как сервер с именем "servers",
    // проваливает валидацию и роняет ВЕСЬ конфиг целиком.
    "localrag": {
      "type": "local",
      "command": [
        "/usr/lib/lib-local-rag/mcp/mcp_launcher.sh"
      ],
      "enabled": true,
      // Таймаут запроса к MCP-серверу, мс. Умолчание агента — 5000, а прогрев
      // модели OpenVINO занимает 40-45 секунд: без явного значения первый же
      // поиск после старта демона отваливается.
      "timeout": 120000,
      // Поле называется environment, а не env: так оно объявлено в
      // McpLocalConfig, и при additionalProperties: false лишнее имя означает
      // непройденную валидацию.
      "environment": {
        // Внутренний таймаут моста, сек. Держим чуть меньше агентского, чтобы
        // осмысленная ошибка моста успела дойти до агента.
        "LQRAG_TIMEOUT": "110"
        // "LQRAG_ALLOW_WRITE": "0"  — прячет от агента управление индексацией
        // (add/remove path, rescan). По умолчанию оно включено: в
        // бесшовной поставке агент — единственный пульт индексации. Выключать
        // только в закрытых установках. Автоматическая регистрация это
        // значение, как и "enabled": false, сохраняет.
        //
        // LQRAG_URL здесь НЕ задаём намеренно. Без него мост читает порт,
        // опубликованный демоном в ~/.files-search/port, и запись переживает
        // перезапуск индексатора на другом порту (в том числе RAG_PORT=0).
        // Зашитый адрес отключил бы этот механизм: он сильнее порт-файла.
      }
    }
  }
}
