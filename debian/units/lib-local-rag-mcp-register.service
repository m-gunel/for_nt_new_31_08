[Unit]
# Прописывает MCP-мост в конфиги агентских приложений ОТ ИМЕНИ ПОЛЬЗОВАТЕЛЯ.
#
# Почему не в postinst. Maintainer-скрипты работают от root, а конфиги агентов
# лежат в домашних каталогах. Записанный от root файл получил бы владельца root,
# и агент (как и этот же скрипт при следующем запуске) уже не смог бы его
# переписать. Хуже того: при сборке образа ОС и тиражировании через СУС
# домашних каталогов ещё не существует — они создаются при первом входе, — а
# на АРМ они бывают на автомонтируемой сетевой ФС, недоступной root в момент
# установки пакета. Пользовательский юнит снимает все три проблемы разом.
#
# postinst в уже открытых сессиях зовёт тот же скрипт сам, через runuser от
# имени пользователя, — чтобы установка сразу показала, куда записано. Это
# только ускорение для текущей сессии: при каждом входе регистрацию делает
# этот юнит.
Description=LocalRAG — регистрация MCP-моста в конфигах агентов
Documentation=file:/usr/lib/lib-local-rag/mcp/README.md
# Не для greeter-а и root: см. lib-local-rag.service.
ConditionUser=!@system

# Страховка от расходящихся срабатываний .path-юнитов. Скрипт идемпотентен и
# сам обрывает цепочку (файл не переписывается, если запись уже верна), но если
# что-то в системе всё же начнёт дёргать юнит по кругу, лимит остановит это,
# а не оставит машину крутить процесс. Пределы намеренно щедрые: упереться в
# них при нормальной работе нельзя, а failed-состояние глушит и полезные
# срабатывания тоже.
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=oneshot
# RemainAfterExit=yes здесь СТАВИТЬ НЕЛЬЗЯ. С ним юнит остаётся active, а
# systemd не перезапускает уже активный Unit= по срабатыванию .path — то есть
# случай «агента поставили после входа в сессию» и случай «приложение
# перезаписало конфиг» перестали бы закрываться. Плата за это — после
# успешного прогона `systemctl --user status` показывает inactive (dead) с
# status=0/SUCCESS. Это норма, а не сбой.
ExecStart=/usr/bin/python3 /usr/lib/lib-local-rag/mcp/register_mcp.py --all \
    --launcher /usr/lib/lib-local-rag/mcp/mcp_launcher.sh
# Регистрация — вспомогательная работа, она не должна конкурировать за диск с
# тем, что пользователь делает руками.
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=default.target