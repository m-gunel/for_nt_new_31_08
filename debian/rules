#!/usr/bin/make -f
#
# Пакет собирается из УЖЕ ГОТОВОГО каталога dist/: бинарь делает PyInstaller,
# мост и конфиг докладывает make. То есть перед dpkg-buildpackage должен быть
# выполнен `make build` (или `make docker_build`) — см. цель `deb` в Makefile.
# Своей сборки у пакета нет.

%:
	dh $@

# Своей сборки нет — глушим весь auto-слой.
#
# Целей configure/install/clean в корневом Makefile сейчас нет, и debhelper их
# пропустил бы сам. Но buildsystem он выбирает по НАЛИЧИЮ Makefile, а не по
# содержимому: появится в нём когда-нибудь цель `clean` — и dh_auto_clean
# начнёт звать её посреди сборки пакета, вычищая тот самый dist/, из которого
# пакет и собирается. Перечисляем все четыре явно.
override_dh_auto_configure:

override_dh_auto_build:

override_dh_auto_test:

override_dh_auto_install:

override_dh_auto_clean:

# --- бандл PyInstaller трогать нельзя -----------------------------------------
#
# dist/main/_internal/ — это сотни чужих .so, приехавших вместе с бинарём.
# Стандартные шаги dh рассчитаны на библиотеки, собранные из исходников в этом
# же пакете, и на бандле ведут себя плохо.

# dh_shlibdeps без --ignore-missing-info ПАДАЕТ на них с «no dependency
# information found for <lib> (used by <bin>)»: у приватных библиотек
# PyInstaller нет ни SONAME, ни shlibs-файла в системе, и взяться им неоткуда —
# они не установлены, а лежат рядом с бинарём и подхватываются через RPATH.
# Результат при этом никому не нужен: ${shlibs:Depends} в debian/control не
# используется (почему — см. комментарий там же).
override_dh_shlibdeps:

# dh_makeshlibs нашёл бы в бандле .so с SONAME (libssl, libpython и прочие) и
# объявил бы наш пакет их поставщиком — control-файл shlibs с чужими
# библиотеками. Вместе с этим он может вставить триггер ldconfig: лишний прогон
# ldconfig на каждой установке ради библиотек, которые через ld.so.conf никто
# не ищет, — бандл находит их сам, через RPATH.
override_dh_makeshlibs:

# dh_strip снял бы символы с бинаря и .so и породил -dbgsym. Бутлоадер
# PyInstaller несёт приложенные к себе данные, и strip по нему — известный
# способ получить «собралось, но молча не запускается». Отладочный пакет от
# чужих библиотек нам всё равно не нужен.
override_dh_strip:

# dh_dwz — по той же причине, что dh_strip: чужие ELF без нашей отладочной
# информации. Работать не над чем, а падать есть на чём.
override_dh_dwz:

# dh_strip_nondeterminism переписывает таймстемпы внутри zip-архивов, а внутри
# бандла лежит base_library.zip. Воспроизводимость сборки мы получаем из
# uv.lock и закоммиченного main.spec, а не из правки чужого артефакта.
override_dh_strip_nondeterminism:

# --- ВНИМАНИЕ: dh_installsystemduser здесь НЕ глушится ------------------------
#
# Именно она включает наши пользовательские юниты. Команда входит в стандартную
# последовательность dh начиная с compat 12, сканирует готовый каталог сборки
# usr/lib/systemd/user, находит там оба юнита (основной кладёт она сама из
# debian/lib-local-rag.user.service, вспомогательные — dh_install из
# debian/install) и через маркер #DEBHELPER# вставляет в postinst
# `deb-systemd-helper --user enable`, а в postrm — парное снятие.
#
# Не добавляйте сюда override_dh_installsystemduser по аналогии с шагами выше:
# автозапуск исчезнет молча, и пакет будет ставиться «успешно», не поднимая
# демон ни у одного пользователя.
#
# Парного override_dh_installsystemd тоже больше нет, и он не нужен: системных
# юнитов пакет не ставит, а файл называется .user.service — под шаблон
# debian/<pkg>.service, который dh_installsystemd кладёт в /lib/systemd/system,
# он не подходит. Раньше здесь стояла заглушка, и она была единственным, что
# мешало разложить ВТОРОЙ, системный экземпляр юнита с запуском от root.
