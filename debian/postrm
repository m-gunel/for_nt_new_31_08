#!/bin/sh
# БТ §7 «Удаление»: (a) останов демона — в prerm; (b) удаление индексов,
# (c) следов (конфиги, временные файлы, port/pid) и (d) уведомление об этом —
# здесь, только на purge. remove данные оставляет: на большом корпусе индекс
# собирается часами.
set -e

# Та же граница обычных пользователей, что в postinst.
uid_min() {
    min=""
    if [ -r /etc/login.defs ]; then
        min=$(sed -n 's/^[[:space:]]*UID_MIN[[:space:]][[:space:]]*\([0-9][0-9]*\).*/\1/p' \
            /etc/login.defs | tail -n 1)
    fi
    case "$min" in
        ''|*[!0-9]*) min=1000 ;;
    esac
    echo "$min"
}

# uid запущенных менеджеров systemd --user — см. postinst.
active_uids() {
    [ -d /run/systemd/system ] || return 0
    systemctl list-units --type=service --state=active --plain --no-legend 'user@*.service' \
        | sed -n 's/^[[:space:]]*user@\([0-9][0-9]*\)\.service[[:space:]].*/\1/p'
}

# uid владельцев /home/* и /home/work/* (stat без -L — владелец самого
# каталога, не цели симлинка). Фильтр по UID_MIN и дедупликация — у вызывающего.
home_owner_uids() {
    for d in /home/* /home/work/*; do
        [ -d "$d" ] || continue
        stat -c %u "$d" 2>/dev/null || true
    done
}

# Итог для уведомления (d), печатается в конце.
purged=""   # «    <каталог>  (<пользователь>)» построчно
failed=""   # что удалить не удалось
checked=""  # чьи дома проверены, через запятую

# Удалить данные индексатора в доме $2 пользователя с uid $1 ($3 — имя для
# итога). Только если каталог принадлежит uid: пути папки разработчика строятся
# по имени, и чужой каталог с совпавшим именем трогать нельзя. rm -rf на
# симлинке удаляет сам симлинк, а не цель.
purge_home() {
    [ -n "$2" ] && [ -d "$2" ] || return 0
    [ "$(stat -L -c %u "$2" 2>/dev/null)" = "$1" ] || return 0
    removed=""
    for dir in "$2/.files-search" "$2/.ragsearch"; do
        if [ -e "$dir" ] || [ -L "$dir" ]; then
            # Сетевой дом с root_squash root удалить не даст — purge не роняем.
            if rm -rf "$dir"; then
                removed="yes"
            else
                echo "LocalRAG: не удалось удалить $dir — удалите вручную." >&2
                failed="$failed    $dir
"
            fi
        fi
    done
    if [ -n "$removed" ]; then
        purged="$purged    $2  ($3)
"
    fi
}

purge_user_data() {
    # Удаление из образа ОС: дома машины сборки к нему отношения не имеют.
    [ -z "${DPKG_ROOT:-}" ] || return 0
    min=$(uid_min)
    seen=" "
    # Те же три источника пользователей, что в prerm (там — зачем владельцы
    # каталогов).
    for uid in $(active_uids) $(getent passwd | cut -d: -f3) $(home_owner_uids); do
        case "$uid" in
            ''|*[!0-9]*) continue ;;
        esac
        [ "$uid" -ge "$min" ] || continue
        case "$seen" in
            *" $uid "*) continue ;;
        esac
        seen="$seen$uid "

        entry=$(getent passwd "$uid") || entry=""
        name=${entry%%:*}
        home=$(printf '%s\n' "$entry" | cut -d: -f6)
        if [ -n "$name" ]; then
            # Учётки без дома (nobody) в итог не попадают.
            if [ -d "$home" ]; then
                checked="$checked${checked:+, }$name"
            fi
            # Кроме pw_dir — пара SberOS: папка разработчика /home/work/ИМЯ
            # (туда пишет индекс демон, запущенный из терминала) и, у
            # ЛОГИН@ДОМЕН, /home/ДОМЕН@ЛОГИН.
            purge_home "$uid" "$home" "$name"
            purge_home "$uid" "/home/work/$name" "$name"
            case "$name" in
                *@*) purge_home "$uid" "/home/${name#*@}@${name%%@*}" "$name" ;;
            esac
        fi
        # Временные выдачи прежних версий (POST /get_file_path): в них письма
        # и вложения.
        find /tmp -maxdepth 1 -name 'rag_file_*' -user "$uid" \
            -exec rm -rf {} + 2>/dev/null || true
    done

    # Каталоги /home и /home/work по владельцу: для тех, кого passwd уже не
    # знает, и для каталогов, названных не по имени пользователя.
    for d in /home/* /home/work/*; do
        [ -d "$d" ] || continue
        owner=$(stat -c %u "$d" 2>/dev/null) || continue
        case "$owner" in
            ''|*[!0-9]*) continue ;;
        esac
        [ "$owner" -ge "$min" ] || continue
        entry=$(getent passwd "$owner") || entry=""
        name=${entry%%:*}
        purge_home "$owner" "$d" "${name:-uid $owner}"
    done
}

# Итог purge. Подсказку «register_mcp.py --remove» не даём: на purge файлов
# пакета уже нет.
print_purge_summary() {
    echo ""
    echo "LocalRAG удалён."
    if [ -n "${DPKG_ROOT:-}" ]; then
        echo "  Удаление из образа (DPKG_ROOT): домашние каталоги не проверялись."
        echo ""
        return 0
    fi
    if [ -n "$purged" ]; then
        echo "  Индексы и пользовательские настройки (.files-search, .ragsearch) удалены"
        echo "  с устройства:"
        printf '%s' "$purged"
    fi
    if [ -n "$failed" ]; then
        echo "  НЕ удалось удалить (удалите вручную):"
        printf '%s' "$failed"
    fi
    if [ -z "$purged" ] && [ -z "$failed" ]; then
        echo "  Индексов LocalRAG на устройстве не найдено — удалять было нечего."
        if [ -n "$checked" ]; then
            echo "  Проверены домашние каталоги пользователей: $checked."
        fi
    fi
    cat <<'EOF'

  Записи MCP-моста снимаются из конфигов агентов ещё при удалении пакета
  (prerm), у каждого найденного пользователя. Если у кого-то запись localrag
  осталась — пользователь не был найден (не входил в систему, а его каталога
  нет ни в /home, ни в /home/work) или его домашний каталог был недоступен, —
  снимите её вручную: удалите ключ mcp.localrag в ~/.wsc/config/wsc.json и
  mcpServers.localrag в ~/.gigacode/settings.json либо верните резервную
  копию <файл>.localrag-backup, которая лежит рядом с конфигом.

EOF
}

case "$1" in
    purge)
        # Глобальное включение юнитов снимает вставка DEBHELPER
        # (deb-systemd-helper --user purge); свой `systemctl --global disable`
        # разошёлся бы с её учётом состояния.
        purge_user_data
        # distro.yml снимает dpkg (conffile), а отложенную preinst копию он не
        # знает — убираем сами (БТ §7). DPKG_ROOT — для образа без chroot.
        rm -f "${DPKG_ROOT:-}/etc/lib-local-rag/distro.yml.localrag-old"
        rmdir "${DPKG_ROOT:-}/etc/lib-local-rag" 2>/dev/null || true
        print_purge_summary
        ;;
    remove)
        # На purge dpkg сначала зовёт postrm с remove, и «индексы сохранены»
        # противоречили бы итогу purge. Status-Want=purge выставлен до скриптов.
        want=$(dpkg-query -W -f='${db:Status-Want}' lib-local-rag 2>/dev/null) || want=""
        if [ "$want" != purge ]; then
            echo "LocalRAG удалён. Индексы СОХРАНЕНЫ — для полной очистки: sudo dpkg --purge lib-local-rag"
        fi
        ;;
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
esac

#DEBHELPER#

# После remove: снять runtime-маску prerm — иначе до конца сессии мост отвечал
# бы «идёт установка» при удалённом пакете. Маска — симлинк на /dev/null,
# удаляем только такой, от root, без захода в менеджер пользователя.
#
# Затем SIGHUP менеджерам — это daemon-reload одной командой и без D-Bus (на
# compat 14 его вставит debhelper — тогда блок удалить). --kill-whom=main
# обязателен: без него SIGHUP получат все процессы сессии; до systemd 252 опция
# называлась --kill-who. После маркера DEBHELPER — чтобы перечитать итоговые
# симлинки.
if [ "$1" = "remove" ] && [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
    for mask in /run/user/*/systemd/user/lib-local-rag.service; do
        if [ -L "$mask" ] && [ "$(readlink "$mask")" = /dev/null ]; then
            rm -f "$mask" || true
        fi
    done
    systemctl kill --kill-whom=main --signal=SIGHUP 'user@*.service' >/dev/null 2>&1 \
        || systemctl kill --kill-who=main --signal=SIGHUP 'user@*.service' >/dev/null 2>&1 \
        || true
fi

exit 0
