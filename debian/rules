#!/usr/bin/make -f
# Пакет собирается из готового dist/: перед dpkg-buildpackage нужен `make build`
# (или `make docker_build`), см. цель `deb` в Makefile.

%:
	dh $@

# Своей сборки нет — глушим auto-слой целиком. Buildsystem debhelper выбирает по
# наличию Makefile: появись в нём цель clean, dh_auto_clean вычистил бы dist/.
override_dh_auto_configure:

override_dh_auto_build:

override_dh_auto_test:

override_dh_auto_install:

override_dh_auto_clean:

# Шаги ниже рассчитаны на библиотеки, собранные в этом пакете, а
# dist/main/_internal/ — сотни чужих .so бандла PyInstaller.

# dh_shlibdeps падает на приватных .so бандла («no dependency information
# found»): в системе их нет, бинарь находит их через RPATH. ${shlibs:Depends} в
# debian/control всё равно не используется.
override_dh_shlibdeps:

# dh_makeshlibs объявил бы пакет поставщиком чужих .so (libssl, libpython) и
# добавил бы лишний триггер ldconfig.
override_dh_makeshlibs:

# strip ломает бутлоадер PyInstaller (данные приложены к бинарю): собирается,
# но молча не запускается.
override_dh_strip:

# dh_dwz — то же, что dh_strip: чужие ELF без нашей отладочной информации.
override_dh_dwz:

# Не переписывать base_library.zip внутри бандла; воспроизводимость дают
# uv.lock и main.spec.
override_dh_strip_nondeterminism:

# dh_installsystemduser здесь НЕ глушится.
#
# Именно она включает наши пользовательские юниты. Команда входит в стандартную
# последовательность dh начиная с compat 12, сканирует готовый каталог сборки
# usr/lib/systemd/user, находит там оба юнита (основной кладёт она сама из
# debian/lib-local-rag.user.service, вспомогательные — dh_install из
# debian/install) и через маркер #DEBHELPER# вставляет в postinst
# `deb-systemd-helper --user enable`, а в postrm — парное снятие.
#
# override_dh_installsystemduser по аналогии с шагами выше не добавлять: пакет
# будет ставиться «успешно», не поднимая демон ни у кого.
#
# override_dh_installsystemd не нужен: .user.service не подходит под шаблон
# debian/<pkg>.service, системного экземпляра юнита не будет.
