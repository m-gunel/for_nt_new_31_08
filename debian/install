# Бинарь демона со всем, что вшил PyInstaller.
dist/main/*  opt/lib-local-rag/
# MCP-мост: лаунчер, сервер, скрипт регистрации у агента, его README.
dist/mcp/*   usr/lib/lib-local-rag/mcp/
# Конфиг демона. Правится администратором, поэтому в /etc.
dist/cfg/*   etc/lib-local-rag/
# Скрипт полного удаления пользовательских данных. postrm его НЕ вызывает —
# у него своя purge_user_data(), которая обходит домашние каталоги через
# getent passwd от root. Этот кладётся для ручного запуска пользователем.
dist/uninstall.sh  usr/lib/lib-local-rag/
# Вспомогательные пользовательские юниты.
#
# Основного юнита здесь НЕТ намеренно: он называется
# debian/lib-local-rag.user.service, и его раскладывает сам
# dh_installsystemduser — это её штатный суффикс.
#
# Почему вспомогательные лежат в debian/units/, а не рядом с основным: суффикс
# .user. debhelper разбирает как «<имя-бинарного-пакета>.user.service», а пакет
# у нас один. Файл debian/lib-local-rag-mcp-register.user.service был бы молча
# пропущен — такого бинарного пакета в debian/control нет. Штатная
# альтернатива (dh_installsystemduser --name= плюс трёхсоставное имя файла)
# нечитаема.
#
# На включение раскладка не влияет: dh_installsystemduser перебирает готовый
# каталог usr/lib/systemd/user, а не только свои debian/*.user.*, и dh_install
# отрабатывает раньше неё в последовательности dh.
# Перечислять поимённо нельзя: юнитов здесь уже три (сервис регистрации и два
# .path-наблюдателя), и забытая строка проявляется не ошибкой сборки, а тем,
# что у пользователя молча не срабатывает перерегистрация.
debian/units/*  usr/lib/systemd/user/
