#!/bin/sh
# Переход distro.yml из «обычного файла» в conffile.
#
# Сборки до 1.0.7, собранные вручную (tar+ar или dpkg-deb из своего каталога,
# без debhelper), клали /etc/lib-local-rag/distro.yml, НЕ объявляя его в
# DEBIAN/conffiles. Начиная с 1.0.7 пакет собирается только через debhelper, и
# dh_installdeb объявляет всё из /etc conffile'ом. Встретив при обновлении на
# диске файл, который dpkg за этим пакетом как conffile не числит, dpkg считает
# его «созданным администратором» и задаёт вопрос «какую версию оставить». В
# терминале это лишний вопрос, а при неинтерактивной установке (SberEMP,
# `dpkg -i` без tty) — ошибка «end of file on stdin at conffile prompt»:
# пакет остаётся ненастроенным, и postinst не выполняется вовсе. Именно так
# падало обновление 1.0.6 → 1.0.7 на стенде.
#
# Лечение — стандартное для такого перехода: до распаковки убрать старый файл
# с дороги, если dpkg не знает его как conffile. Файл не удаляется, а
# сохраняется рядом: в нём могли быть правки. dpkg затем поставит новый
# distro.yml без вопросов.
#
# Если старая версия была собрана правильно (distro.yml уже conffile), ничего
# не делаем — дальше работает штатная логика conffile'ов dpkg.
set -e

# Путь так, как его знает dpkg (в базе conffiles он без префикса), и путь к
# самому файлу на диске. При установке в образ без chroot (непустой
# DPKG_ROOT) это разные вещи: без префикса preinst отложил бы distro.yml
# машины сборки, а не образа. OLD — имя, под которым файл откладывается; его
# же убирает postrm на purge, а check_deb.sh проверяет, что строка на месте.
CONF=/etc/lib-local-rag/distro.yml
OLD=/etc/lib-local-rag/distro.yml.localrag-old

case "$1" in
    install|upgrade)
        # $2 — версия, с которой обновляемся (при install — версия в состоянии
        # «удалён, но не вычищен»). При первой установке её нет.
        if [ -n "${2:-}" ] && [ -f "${DPKG_ROOT:-}$CONF" ] \
           && dpkg --compare-versions "$2" lt 1.0.7; then
            # Формат ${Conffiles}: строки « /путь md5». Пробелы по краям
            # в шаблоне — чтобы не спутать с похожим путём.
            if ! dpkg-query -W -f='${Conffiles}\n' lib-local-rag 2>/dev/null \
                 | grep -q " $CONF "; then
                mv -f "${DPKG_ROOT:-}$CONF" "${DPKG_ROOT:-}$OLD"
                echo "LocalRAG: $CONF от сборки $2 не был объявлен конфигурационным файлом;"
                echo "          сохранён как $OLD, ставится новый."
            fi
        fi
        ;;
    abort-upgrade)
        ;;
esac

#DEBHELPER#

exit 0
