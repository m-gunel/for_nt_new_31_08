#!/bin/sh
# Перевод distro.yml в conffile. Ручные сборки до 1.0.7 клали его, не объявляя
# conffile'ом; при обновлении dpkg принимает такой файл за правку
# администратора и спрашивает, какую версию оставить, а без tty (SberEMP)
# падает «end of file on stdin at conffile prompt» и postinst не выполняется.
# Поэтому до распаковки откладываем старый файл рядом (в нём могли быть
# правки). Если distro.yml уже conffile — ничего не делаем.
set -e

# Пути — как в базе conffiles, без DPKG_ROOT; на диске префикс добавляется
# (иначе в образе без chroot отложился бы файл машины сборки). OLD убирает
# postrm на purge, а check_deb.sh проверяет, что строка на месте.
CONF=/etc/lib-local-rag/distro.yml
OLD=/etc/lib-local-rag/distro.yml.localrag-old

case "$1" in
    install|upgrade)
        # $2 — прежняя версия (при install — «удалён, но не вычищен»); при
        # первой установке пусто.
        if [ -n "${2:-}" ] && [ -f "${DPKG_ROOT:-}$CONF" ] \
           && dpkg --compare-versions "$2" lt 1.0.7; then
            # Формат ${Conffiles}: строки « /путь md5». Пробелы по краям
            # в шаблоне — чтобы не спутать с похожим путём.
            if ! dpkg-query -W -f='${Conffiles}\n' lib-local-rag 2>/dev/null \
                 | grep -q " $CONF "; then
                mv -f "${DPKG_ROOT:-}$CONF" "${DPKG_ROOT:-}$OLD"
                echo "LocalRAG: $CONF от сборки $2 не был объявлен конфигурационным файлом;"
                echo "          сохранён как $OLD, ставится новый."
            fi
        fi
        ;;
    abort-upgrade)
        ;;
esac

#DEBHELPER#

exit 0
