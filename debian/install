# Бинарь демона со всем, что вшил PyInstaller.
dist/main/*  opt/lib-local-rag/
# MCP-мост: лаунчер, сервер, скрипт регистрации у агента, его README.
dist/mcp/*   usr/lib/lib-local-rag/mcp/
# Конфиг демона. Правится администратором, поэтому в /etc.
dist/cfg/*   etc/lib-local-rag/
# Ручное удаление данных пользователем; postrm его не зовёт — у него своя
# purge_user_data().
dist/uninstall.sh  usr/lib/lib-local-rag/
# Вспомогательные пользовательские юниты; основной (debian/lib-local-rag.user.service)
# раскладывает dh_installsystemduser. Не рядом с ним: имя X.user.service
# debhelper читает как «<бинарный-пакет>.user.service» и молча пропускает, если
# такого пакета нет. Включает их всё равно dh_installsystemduser — она
# перебирает готовый usr/lib/systemd/user, а dh_install отрабатывает раньше неё.
# Маской, а не поимённо: забытая строка не ломает сборку, а молча отключает
# перерегистрацию.
debian/units/*  usr/lib/systemd/user/
