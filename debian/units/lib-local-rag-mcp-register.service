[Unit]
# Прописывает MCP-мост в конфиги агентов от имени пользователя. Не в postinst:
# файл, записанный root, сменил бы владельца и агент не смог бы его
# переписывать, а дома при сборке образа ещё не созданы или лежат на сетевой
# ФС, недоступной root при установке. postinst зовёт тот же скрипт только в
# уже открытых сессиях; при каждом входе регистрирует этот юнит.
Description=LocalRAG — регистрация MCP-моста в конфигах агентов
Documentation=file:/usr/lib/lib-local-rag/mcp/README.md
# Не для greeter-а и root: см. lib-local-rag.service.
ConditionUser=!@system

# Страховка, если .path-юниты начнут дёргать сервис по кругу. Пределы щедрые:
# failed глушит и полезные срабатывания.
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=oneshot
# RemainAfterExit=yes не ставить: активный юнит .path не перезапускает, и
# поздняя установка агента или перезапись конфига не подхватятся. Поэтому
# inactive (dead) со status=0/SUCCESS после прогона — норма.
ExecStart=/usr/bin/python3 /usr/lib/lib-local-rag/mcp/register_mcp.py --all \
    --launcher /usr/lib/lib-local-rag/mcp/mcp_launcher.sh
# Фоновая работа — не конкурировать с пользователем за CPU и диск.
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=default.target