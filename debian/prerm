#!/bin/sh
# БТ §7 «Обновление»: демон останавливается ДО замены файлов, индексы не
# трогаются (их удаляет только postrm на purge). На это время демон ещё и
# маскируется — см. stop_for_all_users; маску снимает postinst.
#
# При обновлении с 1.0.6 dpkg зовёт prerm из 1.0.6; если он упадёт — наш с
# failed-upgrade.
set -e

REGISTER=/usr/lib/lib-local-rag/mcp/register_mcp.py

# Та же граница обычных пользователей, что в postinst.
uid_min() {
    min=""
    if [ -r /etc/login.defs ]; then
        min=$(sed -n 's/^[[:space:]]*UID_MIN[[:space:]][[:space:]]*\([0-9][0-9]*\).*/\1/p' \
            /etc/login.defs | tail -n 1)
    fi
    case "$min" in
        ''|*[!0-9]*) min=1000 ;;
    esac
    echo "$min"
}

# uid запущенных менеджеров systemd --user — см. postinst.
active_uids() {
    [ -d /run/systemd/system ] || return 0
    systemctl list-units --type=service --state=active --plain --no-legend 'user@*.service' \
        | sed -n 's/^[[:space:]]*user@\([0-9][0-9]*\)\.service[[:space:]].*/\1/p'
}

# uid владельцев /home/* и /home/work/* (stat без -L — владелец самого
# каталога, не цели симлинка). Фильтр по UID_MIN и дедупликация — у вызывающего.
home_owner_uids() {
    for d in /home/* /home/work/*; do
        [ -d "$d" ] || continue
        stat -c %u "$d" 2>/dev/null || true
    done
}

# Команда от имени $name (uid $uid) — см. postinst.
run_as_user() {
    timeout 60 runuser -u "$name" -- env -u DBUS_SESSION_BUS_ADDRESS \
        XDG_RUNTIME_DIR="/run/user/$uid" "$@" </dev/null
}

# Заполняет name и home по uid; ложь, если пользователя не видно.
lookup_user() {
    entry=$(getent passwd "$uid") || entry=""
    name=${entry%%:*}
    home=$(printf '%s\n' "$entry" | cut -d: -f6)
    [ -n "$name" ] && [ -n "$home" ]
}

stop_for_all_users() {
    # Образ (DPKG_ROOT: systemctl дотянулся бы до машины сборки), нет systemd,
    # запрет policy-rc.d (101) — останавливать нечего или нельзя.
    [ -z "${DPKG_ROOT:-}" ] || return 0
    [ -d /run/systemd/system ] || return 0
    if [ -x /usr/sbin/policy-rc.d ]; then
        rc=0
        /usr/sbin/policy-rc.d lib-local-rag.service stop || rc=$?
        [ "$rc" -ne 101 ] || return 0
    fi
    command -v runuser >/dev/null 2>&1 || return 0

    # Останов пользовательских юнитов debhelper на compat 13 не генерирует;
    # почему не deb-systemd-invoke — см. шапку postinst.
    min=$(uid_min)
    for uid in $(active_uids); do
        [ "$uid" -ge "$min" ] || continue
        lookup_user || continue
        # Порядок: .path (иначе запись в конфиг агента снова запустит
        # регистрацию), сервис регистрации, демон. stop синхронный:
        # TimeoutStopSec=30 у демона меньше 60 c timeout. stderr заглушён:
        # останов незагруженного юнита — не ошибка.
        run_as_user systemctl --user --no-pager stop \
            lib-local-rag-mcp-register-wsc.path \
            lib-local-rag-mcp-register-gigacode.path >/dev/null 2>&1 || true
        run_as_user systemctl --user --no-pager stop \
            lib-local-rag-mcp-register.service >/dev/null 2>&1 || true
        # Маска — ДО останова демона: MCP-мост в агенте на отказе соединения
        # сам зовёт `systemctl --user start`, и без маски демон поднялся бы
        # из наполовину распакованного /opt, а после purge заново создал бы
        # ~/.files-search. --runtime: маска живёт до конца сессии; снимает её
        # postinst (и на abort-*), а после remove — postrm.
        run_as_user systemctl --user --no-pager --quiet mask --runtime \
            lib-local-rag.service >/dev/null 2>&1 || true
        run_as_user systemctl --user --no-pager stop \
            lib-local-rag.service >/dev/null 2>&1 || true
    done
}

# Снять запись MCP-моста из конфигов агентов. Здесь, а не в postrm: на purge
# файлы пакета, и register_mcp.py с ними, удаляются до postrm. После
# stop_for_all_users — иначе .path-юнит вписал бы запись обратно. Только на
# remove: при upgrade запись должна сохраниться.
#
# От имени пользователя: правка от root сменила бы владельца конфига, и агент
# перестал бы его перезаписывать.
#
# Пользователи — запущенные менеджеры systemd --user, getent passwd и владельцы
# /home/* и /home/work/*. Последнее — для доменного пользователя SSSD не в
# сессии: из перечисления passwd его прячет enumerate = false, а удаление через
# SberEMP идёт ночью; по uid SSSD отдаёт имя и дом из кэша. Кого не нашли и
# так, снимают запись вручную (см. итог postrm).
#
# Сбои (нет runuser, недоступный дом, python3) удаление не роняют.
unregister_for_all_users() {
    [ -z "${DPKG_ROOT:-}" ] || return 0
    [ -f "$REGISTER" ] || return 0
    command -v runuser >/dev/null 2>&1 || return 0
    min=$(uid_min)
    seen=" "
    for uid in $(active_uids) $(getent passwd | cut -d: -f3) $(home_owner_uids); do
        case "$uid" in
            ''|*[!0-9]*) continue ;;
        esac
        [ "$uid" -ge "$min" ] || continue
        case "$seen" in
            *" $uid "*) continue ;;
        esac
        seen="$seen$uid "
        lookup_user || continue
        # Учётки без дома (nobody и т.п.) пропускаем: записей у них нет.
        [ -d "$home" ] || continue
        rc=0
        out=$(run_as_user env -u XDG_CONFIG_HOME HOME="$home" \
            python3 "$REGISTER" --remove 2>&1) || rc=$?
        if [ "$rc" -ne 0 ] || printf '%s\n' "$out" | grep -q 'ОШИБКА'; then
            echo "LocalRAG: ВНИМАНИЕ: регистрацию MCP у пользователя $name снять не удалось полностью (код $rc):" >&2
            printf '%s\n' "$out" | sed -e '/^[[:space:]]*$/d' -e 's/^/    /' >&2
            echo "  Снимите вручную в файлах из строк выше: ключ mcp.localrag в .wsc/config/wsc.json," >&2
            echo "  mcpServers.localrag в .gigacode/settings.json (или верните <файл>.localrag-backup)." >&2
            continue
        fi
        report=$(printf '%s\n' "$out" | grep 'регистрация снята') || report=""
        if [ -n "$report" ]; then
            echo "LocalRAG: пользователь $name — снята регистрация MCP:"
            printf '%s\n' "$report" | sed 's/^[[:space:]]*/    /'
        fi
    done
}

case "$1" in
    remove)
        stop_for_all_users
        unregister_for_all_users
        ;;
    upgrade|deconfigure)
        stop_for_all_users
        ;;
    failed-upgrade)
        # Упал prerm старой версии. Код 0 пускает обновление дальше, а останов
        # повторяем сами — старый prerm мог не успеть остановить демон.
        stop_for_all_users || true
        exit 0
        ;;
esac

#DEBHELPER#

exit 0
