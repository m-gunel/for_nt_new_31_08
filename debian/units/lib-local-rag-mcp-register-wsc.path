[Unit]
Description=LocalRAG — следить за конфигами Workspace Computer
Documentation=file:/usr/lib/lib-local-rag/mcp/README.md
# Не для greeter-а и root: см. lib-local-rag.service.
ConditionUser=!@system

[Path]
# ТОЛЬКО PathChanged=, и это принципиально.
#
# PathExists= проверяет условие, а не событие: после того как сервис отработал
# и стал inactive, systemd перевзводит .path-юнит, снова видит существующий
# путь и запускает сервис опять — и так по кругу. Связка «PathExists= +
# oneshot без RemainAfterExit» даёт бесконечный цикл. PathChanged= срабатывает
# по факту изменения (inotify), поэтому цикла не образует.
#
# Следим за КАТАЛОГОМ, а не за самим wsc.json: в момент входа в сессию файла
# может ещё не быть, а появиться он может позже — вместе с остальными
# конфигами агента или отдельно от них. Наблюдение за каталогом ловит любое
# такое появление, а не только запись в уже существующий файл.
#
# Если каталога ещё нет, systemd вешает наблюдение на ближайшего
# существующего предка и сработает, когда каталог появится. Это и закрывает
# случай «агента поставили после входа в сессию».
#
# Наша собственная запись в этот каталог тоже меняет его и вызовет один лишний
# прогон сервиса. Он безвреден: register_mcp.py увидит, что запись уже на
# месте, файла не коснётся, и цепочка оборвётся на первом же круге.
PathChanged=%h/.wsc/config
# На SberOS у разработчика две папки: pw_dir /home/ДОМЕН@ЛОГИН (это %h, там
# GUI и основной конфиг) и папка разработчика /home/work/ЛОГИН@ДОМЕН, где
# агент может стоять вторым экземпляром. %u раскрывается в ЛОГИН@ДОМЕН.
# Несуществующий путь безвреден — см. выше про ближайшего предка; у кого
# такой папки нет, строка просто ничего не ловит.
PathChanged=/home/work/%u/.wsc/config
Unit=lib-local-rag-mcp-register.service

[Install]
WantedBy=default.target
