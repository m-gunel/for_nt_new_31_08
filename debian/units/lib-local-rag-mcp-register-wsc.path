[Unit]
Description=LocalRAG — следить за конфигами Workspace Computer
Documentation=file:/usr/lib/lib-local-rag/mcp/README.md
# Не для greeter-а и root: см. lib-local-rag.service.
ConditionUser=!@system

[Path]
# Только PathChanged=: PathExists= — условие, а не событие, и с oneshot без
# RemainAfterExit перезапускает сервис по кругу.
#
# Следим за каталогом: wsc.json может появиться уже после входа в сессию.
# Пока каталога нет, systemd следит за ближайшим существующим предком — так
# ловится и установка агента после входа. Наша запись даёт один лишний прогон,
# на котором register_mcp.py файл не трогает, и цепочка обрывается.
PathChanged=%h/.wsc/config
# Папка разработчика SberOS /home/work/ЛОГИН@ДОМЕН (%u), где агент может стоять
# вторым экземпляром; %h — pw_dir /home/ДОМЕН@ЛОГИН. Нет папки — строка ничего
# не ловит.
PathChanged=/home/work/%u/.wsc/config
Unit=lib-local-rag-mcp-register.service

[Install]
WantedBy=default.target
