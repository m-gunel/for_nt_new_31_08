[Unit]
# Пользовательский юнит (systemd --user), а не системный: демон обязан работать
# с правами владельца файлов. Системный сервис от root упирался бы в права на
# домашние каталоги и складывал индексы не туда — БТ §4.1 требует user-space
# демона именно поэтому.
Description=LocalRAG — локальный индексатор файлов пользователя
Documentation=file:/usr/lib/lib-local-rag/mcp/README.md
# Юниты включены глобально (--global), то есть для КАЖДОГО менеджера
# systemd --user, включая менеджер greeter-а экрана входа и root. Без условия
# демон стартовал бы и у них, а root с paths: /home проиндексировал бы весь
# /home, чужие файлы тоже, в /root/.files-search. @system — это uid из
# системного диапазона (root, greeter, служебные учётки); доменные и локальные
# пользователи в него не входят.
ConditionUser=!@system

[Service]
Type=exec
Environment=CONFIG_PATH=/etc/lib-local-rag/distro.yml
# Явно localhost: умолчание демона — 0.0.0.0, то есть поиск по личным файлам
# отдавался бы всей сети без авторизации.
Environment=RAG_HOST=127.0.0.1
# 0 — порт выбирает ядро, демон публикует фактический в ~/.files-search/port.
# MCP-мост читает его оттуда, поэтому конфиг агента не привязан к номеру.
Environment=RAG_PORT=0
# Буферизация. uvicorn пишет access-лог в stdout, а stdout в пайп systemd
# блочно-буферизуется: строки доезжают до журнала пачками и с задержкой,
# из-за чего «сервис работает, а логов нет» выглядит убедительнее, чем есть.
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/lib-local-rag/main
# Явно, хотя это и умолчание: на корпоративном образе DefaultStandardOutput=
# в /etc/systemd/user.conf может быть переопределён, и тогда вывод демона
# не попадёт в журнал вообще. SyslogIdentifier — чтобы в журнале стояло имя
# сервиса, а не имя бинаря PyInstaller («main»), по которому ничего не найти.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lib-local-rag
Restart=on-failure
RestartSec=5
# Прогрев модели OpenVINO (40-45 секунд) этим таймаутом НЕ покрывается и не
# ограничивается: при Type=exec запуск заканчивается сразу после exec, служба
# уже active, а прогрев идёт следом. Готовность API видна по строке «прогрев
# завершён» в журнале и по ответу моста («запускается или прогревается», пока
# API не отвечает). Здесь это лишь предел на сам запуск процесса — например,
# если /opt на медленном или зависшем носителе.
TimeoutStartSec=180
# Демон завершается по SIGTERM с graceful-таймаутом 5 c (uvicorn), плюс он
# снимает свои port/pid файлы в finally. Даём запас.
TimeoutStopSec=30
# Nice= и IOSchedulingClass= здесь НЕ выставляются намеренно. systemd применяет
# их до exec, то есть к процессу целиком — а документация проекта прямо
# предупреждает: «nice при старте не применять, зависает компиляция модели
# OpenVINO; renice — только после готовности Uvicorn».
#
# Приоритет и так понижается там, где нужно: демон делает это точечно, на
# уровне потоков пула построения индексов (src/utils/thread_priority.py,
# INDEXING_NICE_DELTA=10), уже после прогрева. Глобальный Nice здесь только
# воспроизвёл бы известный зависон.

[Install]
WantedBy=default.target
